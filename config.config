server
{
    listen 8080;

    root .;

    max_body 100G;

    location /images
    {
        methods GET POST;
        index index.html;
        root ./images;
        autoindex on;
    }

    location /upload
    {
        upload_path ./up;
        methods POST;
    }

    location /cgi-bin
    {
        methods GET POST;
        root ./cgi-bin////;
        cgi .py /usr/bin/python3;
    }
}
