server
{
    listen 8080;

    root ./www;
    index index.html;

    max_body 100G;

    location /images
    {
        methods GET POST;
        index index.html;
        upload_path ./www;
        autoindex on;
    }

    location /cgi-bin
    {
        methods GET POST;
        root ./cgi-bin////;
        cgi .py /usr/bin/python3;
    }
}
