server {
    listen 8080;

    root .;
    index index.html;

    max_body 100G;

    location /
    {
        methods GET POST DELETE;
    }

    location /images
    {
        methods GET;
        index index.html;
        autoindex on;
    }
    location /cgi-bin
    {
        methods GET POST;
        root .;
        cgi .py /usr/bin/python3;
    }
}