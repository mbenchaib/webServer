server
{
    listen 127.0.0.1:8080;

    root ./www;

    max_body 100G;

    index index.html;

    error_page 500 ./www/index.html;

    location /images
    {
        methods GET POST;
        index index.html;
        root ./images;
        autoindex on;
    }

    location /upload
    {
        upload_path /Users/mben-cha/goinfre;
        methods POST;
    }

    location /cgi-bin
    {
        methods GET POST;
        root ./cgi-bin////;
        cgi .py /usr/bin/python3;
    }
}
server
{
    listen 4242;

    root .;

    max_body 100G;

    location /images
    {
        methods GET POST;
        index index.html;
        root ./images;
        autoindex on;
    }

    location /upload
    {
        upload_path ./up;
        methods POST;
    }

    location /cgi-bin
    {
        methods GET POST;
        root ./cgi-bin////;
        cgi .py /usr/bin/python3;
    }
}
